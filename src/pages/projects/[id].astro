---
import Layout from '../../layouts/Layout.astro';
import { projects } from '../../data/projects.js';
import { ArrowLeft, Cpu, Layers, Activity } from 'lucide-react';

export function getStaticPaths() {
  return projects.map((project) => ({
    params: { id: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
---

<Layout title={`${project.title} | Case Study`}>
	<div class="min-h-screen bg-background relative z-10">
		
		<nav class="max-w-6xl mx-auto px-6 py-8">
			<a 
				href="/" 
				class="inline-flex items-center gap-2 text-sm font-bold text-muted hover:text-primary transition-colors duration-200 group"
			>
				<ArrowLeft class="w-4 h-4 transform group-hover:-translate-x-1 transition-transform" />
				Back to Showcase
			</a>
		</nav>

		<main class="max-w-6xl mx-auto px-6 pb-24 grid grid-cols-1 lg:grid-cols-12 gap-12 pt-4">
			
			<div class="lg:col-span-7 space-y-6">
				
				<div 
					class="relative w-full rounded-2xl bg-surface border border-border shadow-lg flex items-center justify-center overflow-hidden"
					transition:name={`media-container-${project.id}`}
				>
					<video 
						src={project.videoUrl} 
						poster={project.imageUrl}
						autoplay 
						loop 
						muted 
						controls
						playsinline
						controlsList="nodownload"
						oncontextmenu="return false;"
						class="w-full h-auto max-h-[75vh] object-contain rounded-2xl"
					>
						Your browser does not support video playbacks.
					</video>
				</div>

				<div class="grid grid-cols-2 gap-3 md:gap-4">
					{project.metrics.map((metric) => (
						<div class="bg-card border-2 border-border shadow-md rounded-xl p-3 md:p-5 text-center backdrop-blur-sm transition-all duration-300 hover:border-primary/60 hover:shadow-lg flex flex-col justify-center">
							<p class="text-[10px] md:text-xs tracking-wider uppercase text-muted mb-1 font-bold">{metric.label}</p>
							<p class="text-lg md:text-2xl font-bold bg-gradient-to-r from-primary to-accent bg-clip-text text-transparent leading-tight">{metric.value}</p>
						</div>
					))}
				</div>
			</div>

			<div class="lg:col-span-5 flex flex-col justify-between space-y-8">
				<div class="space-y-6">
					<div>
						<span class="text-xs uppercase tracking-widest text-secondary font-bold px-3 py-1.5 rounded-full bg-secondary/10 border border-secondary/30">
							Case Study
						</span>
						<h1 
							class="text-4xl font-bold font-heading text-foreground tracking-tight mt-6"
							transition:name={`title-${project.id}`}
						>
							{project.title}
						</h1>
						<p class="text-lg text-primary font-medium mt-2">
							{project.subtitle}
						</p>
					</div>

					<hr class="border-border" />

					<p class="text-muted leading-relaxed text-base whitespace-pre-line font-medium">
						{project.longDescription}
					</p>
				</div>

				<div class="space-y-4">
					<h3 class="text-sm font-bold uppercase tracking-wider text-foreground flex items-center gap-2">
						<Cpu class="w-4 h-4 text-accent" /> Applied Architecture & Tech Stack
					</h3>
					<div class="flex flex-wrap gap-2 pt-1">
						{project.tags.map((tag) => (
							<span class="text-xs font-semibold bg-surface border border-border/80 text-foreground px-3 py-1.5 rounded-md shadow-sm hover:border-primary/40 transition-colors">
								{tag}
							</span>
						))}
					</div>
				</div>

			</div>
		</main>
	</div>
</Layout>